        "element.selected": "#DED6F5",
        "text": "#2A2440",
        "text.muted": "#71698F",
        "terminal.background": "#FAF8FE",
        "terminal.foreground": "#2A2440",
        "terminal.ansi.black": "#2A2440",
        "terminal.ansi.red": "#C02A47",
        "terminal.ansi.green": "#147A52",
        "terminal.ansi.yellow": "#8A5A0B",
        "terminal.ansi.blue": "#2B4ACB",
        "terminal.ansi.magenta": "#7C3AED",
        "terminal.ansi.cyan": "#0F6E80",
        "terminal.ansi.white": "#55506E",
        "terminal.ansi.bright_black": "#6B6685",
        "terminal.ansi.bright_red": "#A81E39",
        "terminal.ansi.bright_green": "#0F6444",
        "terminal.ansi.bright_yellow": "#74490A",
        "terminal.ansi.bright_blue": "#2039A8",
        "terminal.ansi.bright_magenta": "#6425C9",
        "terminal.ansi.bright_cyan": "#0B5A69",
        "terminal.ansi.bright_white": "#2A2440",
